# REEF — environment template. Never commit real values (.env is git-ignored).
DATABASE_URL="postgresql://reef:CHANGE_ME@localhost:5432/reef?schema=public"
APP_URL="http://localhost:3100"
SESSION_COOKIE_NAME="reef_session"
SESSION_TTL_DAYS="365"
# Uploaded images directory (mount a persistent volume in production)
STORAGE_LOCAL_DIR="./storage"
# Protects POST /api/internal/* job endpoints (subscriptions run). Unset => endpoints return 404.
# CRON_SECRET="generate with: openssl rand -base64 48"
# First SUPER_ADMIN created by `npm run db:seed` (change the password on first login):
# SEED_ADMIN_PHONE="+971500000000"
# SEED_ADMIN_PASSWORD="CHANGE_ME"
